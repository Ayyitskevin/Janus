{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ayyitskevin/Janus/blob/main/docs/spec/upgrade-preparation-v1.schema.json",
  "title": "Janus upgrade preparation manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "created_at",
    "source",
    "artifacts",
    "live_source",
    "backup",
    "rehearsal",
    "deployment_performed"
  ],
  "properties": {
    "schema": { "const": "janus.upgrade-preparation.v1" },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "source": { "$ref": "#/$defs/source" },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate", "rollback"],
      "properties": {
        "candidate": { "$ref": "#/$defs/candidateArtifacts" },
        "rollback": { "$ref": "#/$defs/rollbackArtifacts" }
      }
    },
    "live_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["database", "identity", "logical_writes"],
      "properties": {
        "database": { "type": "string", "minLength": 1 },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["before", "after"],
          "properties": {
            "before": { "$ref": "#/$defs/databaseFamily" },
            "after": { "$ref": "#/$defs/databaseFamily" }
          }
        },
        "logical_writes": { "const": 0 }
      }
    },
    "backup": {
      "allOf": [
        { "$ref": "#/$defs/databaseFacts" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "integrity_check",
            "migrations",
            "counts",
            "content_sha256"
          ],
          "properties": {
            "path": { "type": "string", "pattern": "^backup/[^/]+$" },
            "sha256": { "$ref": "#/$defs/sha256" },
            "integrity_check": { "const": "ok" },
            "migrations": { "$ref": "#/$defs/migrations" },
            "counts": { "$ref": "#/$defs/counts" },
            "content_sha256": { "$ref": "#/$defs/contentDigests" }
          }
        }
      ]
    },
    "rehearsal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate", "rollback"],
      "properties": {
        "candidate": { "$ref": "#/$defs/candidateResult" },
        "rollback": { "$ref": "#/$defs/rollbackResult" }
      }
    },
    "deployment_performed": { "const": false }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "commit", "tree", "clean"],
      "properties": {
        "repo": { "type": "string", "minLength": 1 },
        "commit": { "$ref": "#/$defs/commit" },
        "tree": { "$ref": "#/$defs/commit" },
        "clean": { "const": true }
      }
    },
    "candidateArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^artifacts/candidate/[^/]+$" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "rollbackArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^artifacts/rollback/[^/]+$" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "candidateArtifactFiles": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/candidateArtifact" },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": ["path"],
            "properties": { "path": { "pattern": "\\.tar\\.gz$" } }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["path"],
            "properties": { "path": { "pattern": "\\.whl$" } }
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "rollbackArtifactFiles": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/rollbackArtifact" },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": ["path"],
            "properties": { "path": { "pattern": "\\.tar\\.gz$" } }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["path"],
            "properties": { "path": { "pattern": "\\.whl$" } }
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "candidateArtifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "files"],
      "properties": {
        "commit": { "$ref": "#/$defs/commit" },
        "files": { "$ref": "#/$defs/candidateArtifactFiles" }
      }
    },
    "rollbackArtifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree", "files"],
      "properties": {
        "commit": { "$ref": "#/$defs/commit" },
        "tree": { "$ref": "#/$defs/commit" },
        "files": { "$ref": "#/$defs/rollbackArtifactFiles" }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device", "inode", "mode", "size", "mtime_ns"],
      "properties": {
        "device": { "type": "integer", "minimum": 0 },
        "inode": { "type": "integer", "minimum": 1 },
        "mode": { "type": "string", "pattern": "^[0-7]{4}$" },
        "size": { "type": "integer", "minimum": 0 },
        "mtime_ns": { "type": "integer", "minimum": 0 }
      }
    },
    "databaseFamily": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directory", "database"],
      "properties": {
        "directory": { "$ref": "#/$defs/identity" },
        "database": { "$ref": "#/$defs/identity" },
        "wal": { "$ref": "#/$defs/identity" },
        "shm": { "$ref": "#/$defs/identity" },
        "journal": { "$ref": "#/$defs/identity" }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "checksum"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "checksum": { "$ref": "#/$defs/sha256" }
      }
    },
    "migrations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/migration" }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gates",
        "gate_options",
        "rulings",
        "observations",
        "check_revisions",
        "audit_events"
      ],
      "properties": {
        "gates": { "type": "integer", "minimum": 0 },
        "gate_options": { "type": "integer", "minimum": 0 },
        "rulings": { "type": "integer", "minimum": 0 },
        "observations": { "type": "integer", "minimum": 0 },
        "check_revisions": { "type": "integer", "minimum": 0 },
        "audit_events": { "type": "integer", "minimum": 0 }
      }
    },
    "contentDigests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gates",
        "gate_options",
        "rulings",
        "observations",
        "check_revisions",
        "audit_events"
      ],
      "properties": {
        "gates": { "$ref": "#/$defs/sha256" },
        "gate_options": { "$ref": "#/$defs/sha256" },
        "rulings": { "$ref": "#/$defs/sha256" },
        "observations": { "$ref": "#/$defs/sha256" },
        "check_revisions": { "$ref": "#/$defs/sha256" },
        "audit_events": { "$ref": "#/$defs/sha256" }
      }
    },
    "databaseFacts": {
      "type": "object",
      "required": ["integrity_check", "migrations", "counts", "content_sha256"],
      "properties": {
        "integrity_check": { "const": "ok" },
        "migrations": { "$ref": "#/$defs/migrations" },
        "counts": { "$ref": "#/$defs/counts" },
        "content_sha256": { "$ref": "#/$defs/contentDigests" }
      }
    },
    "candidateResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "integrity",
        "migrations",
        "packaged_migrations",
        "counts",
        "content_sha256",
        "storage_findings"
      ],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "integrity": { "const": ["ok"] },
        "migrations": { "$ref": "#/$defs/migrations" },
        "packaged_migrations": { "$ref": "#/$defs/migrationVersions" },
        "counts": { "$ref": "#/$defs/counts" },
        "content_sha256": { "$ref": "#/$defs/contentDigests" },
        "storage_findings": { "const": [] }
      }
    },
    "rollbackResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "integrity",
        "migrations",
        "packaged_migrations",
        "counts",
        "content_sha256"
      ],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "integrity": { "const": ["ok"] },
        "migrations": { "$ref": "#/$defs/migrationVersions" },
        "packaged_migrations": { "$ref": "#/$defs/migrationVersions" },
        "counts": { "$ref": "#/$defs/counts" },
        "content_sha256": { "$ref": "#/$defs/contentDigests" }
      }
    },
    "migrationVersions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
